{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loom",
  "version": "0.4.0",
  "identifier": "dev.loom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Loom",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#FAF9F5"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "http://localhost:* http://127.0.0.1:* http://[::1]:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Claude Code CLI 图形外壳",
    "longDescription": "Loom 是 Claude Code CLI 的薄壳：会话管理、BYOK 配置、Skill/插件配置与内置预览。"
  }
}
