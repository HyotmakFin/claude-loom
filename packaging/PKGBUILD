# Maintainer: Misuzu <HyotMakFin@users.noreply.github.com>
pkgname=claude-loom
pkgver=0.4.0
pkgrel=1
pkgdesc='Loom — Claude Code CLI 的图形外壳（Tauri + React）'
arch=('x86_64' 'aarch64')
url='https://github.com/HyotMakFin/claude-loom'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'librsvg')
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'pkgconf' 'gcc')
optdepends=('claude-code: Claude Code CLI（也可通过 npm 全局安装）')
# 上游仓库名是 loom，AUR 包名用 claude-loom（loom 已被占用）
_upstream=claude-loom
source=("$_upstream-$pkgver.tar.gz::https://github.com/HyotMakFin/claude-loom/archive/v$pkgver.tar.gz")
sha256sums=('601028ccebf097d20927d93edce2436948175f571ab09b711cd6e38a5e1ee889')

prepare() {
  cd "$srcdir/$_upstream-$pkgver"
  npm ci --no-audit --no-fund
  # 先把依赖抓齐，build() 中才能完全离线编译
  ( cd src-tauri && cargo fetch --locked )
}

build() {
  cd "$srcdir/$_upstream-$pkgver"
  npm run build
  ( cd src-tauri && cargo build --release --locked --offline --features custom-protocol )
}

package() {
  cd "$srcdir/$_upstream-$pkgver"
  install -Dm755 src-tauri/target/release/loom "$pkgdir/usr/bin/loom"
  # VBlankMonitor 提速补丁（由 src-tauri/build.rs 生成）
  install -Dm755 src-tauri/resources/libloom-vblank.so "$pkgdir/usr/lib/loom/libloom-vblank.so"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  # 桌面文件名、Icon、StartupWMClass 都必须是 `loom`：Linux 下窗口 app_id
  # 由 GtkApplication 的可执行文件名决定（实测为 "loom"），KDE/GNOME 的 Wayland
  # 靠它把窗口关联到 .desktop 与图标
  install -Dm644 packaging/loom.desktop "$pkgdir/usr/share/applications/loom.desktop"
  for size in 32 128 256; do
    install -Dm644 "assets/brand/loom-icon-${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/loom.png"
  done
}
