{
  "name": "claude-loom",
  "private": true,
  "version": "0.5.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "fonts": "python3 scripts/build-fonts.py",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@types/markdown-it": "^14.2.0",
    "markdown-it": "^15.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "main": "electron/main.cjs",
  "description": "A thin, high-refresh-rate desktop shell for the Claude Code CLI",
  "author": {
    "name": "Misuzu",
    "email": "HyotMakFin@users.noreply.github.com"
  },
  "build": {
    "appId": "dev.loom.app",
    "productName": "Loom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sidecar/target/release",
        "to": ".",
        "filter": [
          "loom-backend",
          "loom-backend.exe"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "category": "Development",
      "icon": "electron/icon.png",
      "maintainer": "Misuzu <HyotMakFin@users.noreply.github.com>"
    },
    "pacman": {
      "depends": [
        "c-ares",
        "ffmpeg",
        "gtk3",
        "libevent",
        "libvpx",
        "libxslt",
        "libxss",
        "minizip",
        "nss",
        "re2",
        "snappy",
        "libnotify"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.png",
      "artifactName": "Loom-${version}-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "electron/icon.png",
      "artifactName": "Loom-${version}-${arch}.${ext}",
      "notarize": false
    }
  },
  "license": "MIT"
}
